SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

WORKER_CONCURRENCY=2
WORKER_ID=
TEMP_DIR=

TRANSCRIPTION_PROVIDER=local_faster_whisper
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_BATCH_SIZE=8
YTDLP_JS_RUNTIME=node
# Optional Netscape cookies file if a Twitch/Kick VOD requires auth cookies (public VODs usually do not).
YTDLP_COOKIES_FILE=
# Kick/Twitch: install curl-cffi in the venv so yt-dlp can impersonate a browser (required for many VODs).
# Long Kick/Twitch VODs sample ≤ ASR_SCOUT_BUDGET_SECONDS of audio (not full Whisper). Same flow as YT.
ASR_FULL_MAX_SECONDS=1800
ASR_SCOUT_BUDGET_SECONDS=1200
ASR_SCOUT_CHUNK_SECONDS=90
# Stay under Supabase Free Storage max (~50MB). Raise if you upgrade / bump dashboard limit.
MAX_UPLOAD_BYTES=50331648

LLM_PROVIDER=heuristic
GROQ_API_KEY=
GEMINI_API_KEY=

SEGMENT_PADDING_SECONDS=1.5
MAX_SOURCE_DURATION_SECONDS=7200

FFMPEG_PATH=
FFPROBE_PATH=

REDIS_URL=

LOG_LEVEL=INFO
