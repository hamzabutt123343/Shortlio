{
  "name": "shortlio-desktop",
  "version": "0.2.2",
  "private": true,
  "description": "Shortlio Windows app — local video processing with bundled engine",
  "main": "src/main.js",
  "author": "Shortlio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "bundle:engine": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle-engine.ps1",
    "dist:win": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  }
}
