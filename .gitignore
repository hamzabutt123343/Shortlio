# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!worker/.env.example
!desktop/.env.example

# desktop Electron build output + bundled engine artifacts
desktop/dist/
desktop/resources/engine/**
!desktop/resources/engine/.gitkeep
desktop/resources/ffmpeg/**
!desktop/resources/ffmpeg/.gitkeep
desktop/resources/node/**
!desktop/resources/node/.gitkeep
desktop/resources/bin/**
!desktop/resources/bin/.gitkeep

# worker
worker/.venv/
worker/tmp/
worker/tmp_*/
worker/tmp_*.txt
worker.zip
worker/**/__pycache__/
*.pyc

# local SQL apply helpers (not part of schema)
supabase/expr*.js
supabase/run_expr*.js
supabase/b64p*.txt
supabase/chunk*.txt
supabase/chunks.json
supabase/chunk_meta.txt
supabase/build_rest_expr.js
supabase/inject_sql.js
supabase/cdp_*.json
supabase/SETUP_ALL.b64
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
