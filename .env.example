# =============================================================================
# Shortlio — copy to .env.local (web) and worker/.env (worker). Never commit secrets.
# =============================================================================

# --- Supabase (required for auth, DB, storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (auth redirects, billing return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (provider-independent) ---
# lemon_squeezy (default) or stripe
BILLING_PROVIDER=lemon_squeezy

# Lemon Squeezy (free to create account; test mode available)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Stripe (optional alternative)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Worker (also set in worker/.env) ---
# TRANSCRIPTION_PROVIDER=local_faster_whisper | groq
# WHISPER_MODEL=base
# LLM_PROVIDER=heuristic | groq | gemini
# GROQ_API_KEY=          # free tier; optional
# GEMINI_API_KEY=        # free tier; optional
# WORKER_CONCURRENCY=1
# TEMP_DIR=./tmp
# SEGMENT_PADDING_SECONDS=0.35
# MAX_SOURCE_DURATION_SECONDS=7200
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
