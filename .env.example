# =============================================================================
# Shortlio — copy to .env.local (web) and worker/.env (worker). Never commit secrets.
# =============================================================================

# --- Supabase (required for auth, DB, storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (auth redirects, billing return URLs)
# Production: https://your-app.vercel.app — also set GitHub Actions variable SHORTLIO_APP_URL
# to the same value when packaging the Windows desktop shell.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billing (provider-independent) ---
# lemon_squeezy (default) or stripe
BILLING_PROVIDER=lemon_squeezy

# Lemon Squeezy (free to create account; test mode available)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Stripe (optional alternative)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- AI / LLM (web regenerate + desktop Groq Whisper proxy) ---
# LLM_PROVIDER=heuristic | groq | gemini
GROQ_API_KEY=
# GEMINI_API_KEY=

# Desktop engine calls /api/desktop/ai/transcribe — GROQ_API_KEY must be on the web server.
# Never put GROQ_API_KEY or SUPABASE_SERVICE_ROLE_KEY in the Windows EXE.

# --- Dev/optional cloud worker (also set in worker/.env) ---
# TRANSCRIPTION_PROVIDER=local_faster_whisper | groq | groq_proxy
# WHISPER_MODEL=base
# WORKER_CONCURRENCY=1
# TEMP_DIR=./tmp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
